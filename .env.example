# Frontend Environment Configuration for Live Social OAuth Redirection
# Copy this file to '.env' and put your live Client ID from Google Cloud Console / Meta Developer Portal

VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Backend API Base URL (Leave empty or set to your deployed backend URL on Render/Railway)
# Example: VITE_API_URL=https://asiamart-backend.onrender.com/api
VITE_API_URL=
